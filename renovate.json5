{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
  ],
  automerge: true,
  major: {
    automerge: false,
  },
  minimumReleaseAge: '3 days',
  osvVulnerabilityAlerts: true,
  vulnerabilityAlerts: { enabled: true },
  rebaseWhen: 'behind-base-branch',
  packageRules: [
    {
      // Image CVE fixes keep the 1 day wait. Routine updates wait 3 days.
      matchManagers: ['docker', 'helm-values'],
      minimumReleaseAge: '1 day',
    },
    {
      matchPackageNames: ['github.com/go-logr/stdr'],
      abandonmentThreshold: null, // Never mark as abandoned
    },
    {
      matchPackageNames: ['sigs.k8s.io/yaml'],
      abandonmentThreshold: null, // Stable k8s lib; low churn, not dead
    },
    {
      matchManagers: ['github-actions'],
      semanticCommitType: 'ci', // Action-only weeks must not ship
    },
  ],
}
