{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
    ':semanticCommits',
  ],
  automerge: true,
  major: {
    automerge: false,
  },
  minimumReleaseAge: '7 days',
  rebaseWhen: 'behind-base-branch',
  packageRules: [
    {
      matchPackageNames: ['github.com/go-logr/stdr'],
      abandonmentThreshold: null, // Never mark as abandoned
    },
    {
      matchPackageNames: ['anothrNick/github-tag-action'],
      abandonmentThreshold: null, // Still works; no maintained fork to move to
    },
  ],
}
